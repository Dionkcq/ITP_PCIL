# Required for live LLM recommendations (Pipeline #3 composer).
# Without it the API still works; operator_recommendation degrades to a
# fallback string. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── docker-compose variables (read by docker-compose.yml) ────────────
# Host folder mounted at /app/data in the container. Default ./data
# (a data/ folder next to docker-compose.yml). From a dev checkout where
# data/ lives one level up, use ../data
#PCIL_DATA_DIR=./data
# Host folder of config recipes, mounted at /app/machines so dashboard
# Config-tab edits persist across container restarts. Default ./machines
# (the repo checkout already has it next to docker-compose.yml).
#PCIL_MACHINES_DIR=./machines
# Image reference to run. Default ghcr.io/dionkcq/itp_pcil:latest;
# set to pcil:latest to run a locally built image.
#PCIL_IMAGE=pcil:latest
# Host port the API is exposed on. Default 8000.
#PCIL_PORT=8000

# PostgreSQL/pgvector RAG backend. Docker Compose defaults to postgres;
# set RAG_BACKEND=file for the older DOCX + in-process TF-IDF path.
#RAG_BACKEND=postgres
#RAG_AUTO_INGEST=true
#RAG_EMBEDDING_MODEL=BAAI/bge-m3
#RAG_RRF_K=60
#RAG_STRICT_STARTUP=false

# PostgreSQL credentials for the docker-compose postgres service.
#POSTGRES_DB=pcil
#POSTGRES_USER=pcil
# Required: set a strong local password. Do not commit real secrets.
# Example generation:
#   powershell -NoProfile -Command "[guid]::NewGuid().ToString('N')"
POSTGRES_PASSWORD=

# ── optional Flask demo UI (rag_frontend/) only ──────────────────────
ORCHESTRATOR_URL=http://localhost:8000
PCIL_CONFIG_PATH=machines/inkjet_printer/config.yaml

# Only set when running the orchestrator OUTSIDE Docker from a directory
# that is not the project root. Never pass this into the container — the
# image bakes in /app, and overriding it breaks every data path
# (docker-compose.yml deliberately forwards only GEMINI_API_KEY).
#PCIL_PROJECT_ROOT=/path/to/project/root
