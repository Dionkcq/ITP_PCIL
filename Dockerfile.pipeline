# PCIL Pipeline service image (PCIL_SERVICE=pipeline).
# ----------------------------------------------------------------------------
# Serves the dashboard + /pipeline, /configs, /shopfloor and the FULL pgvector
# hybrid RAG (BM25 + dense embeddings + RRF). It proxies /anomaly/* to the
# anomaly service (ANOMALY_SERVICE_URL), so it does NOT run anomaly detection
# and never imports the cyclical autoencoder. Use the split compose file:
#     docker compose -f docker-compose.split.yml up -d --build
#
# Because the hybrid RAG embeds with sentence-transformers (torch), this image
# carries torch — it is NOT the lightweight file-RAG variant.

# ── Stage 1: build the React dashboard ───────────────────────────────
FROM node:20-slim AS dashboard-build
WORKDIR /build/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

# ── Stage 2: Python runtime ──────────────────────────────────────────
# Python 3.12: tokenizers/transformers have full PyO3 support.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the CPU-only torch wheel first (the default PyPI torch bundles CUDA,
# ~GB). The requirements install then sees torch==2.12.0 already satisfied.
# transformers/tokenizers build from source -> need a Rust compiler for the
# install step; remove it afterwards to keep the image slimmer.
COPY requirements-pipeline.txt ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential rustc \
    && pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-pipeline.txt \
    && apt-get purge -y build-essential rustc gcc g++ make \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Application code. pcil/ includes the anomaly modules, but pipeline mode never
# imports them (see the service-composition block in orchestrator.py).
COPY pcil/ ./pcil/
COPY systems/ ./systems/
COPY --from=dashboard-build /build/dashboard/dist/ ./dashboard/dist/

ENV DASHBOARD_DIST_DIR=/app/dashboard/dist
ENV PCIL_PROJECT_ROOT=/app
ENV PCIL_SERVICE=pipeline
ENV HF_HOME=/root/.cache/huggingface
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

VOLUME ["/app/data"]
EXPOSE 8000

CMD ["uvicorn", "pcil.orchestrator:app", "--host", "0.0.0.0", "--port", "8000"]
